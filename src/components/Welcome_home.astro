<section class="welcome relative">
  <!-- Fondo -->
  <div class="welcome__sky"></div>

  <img
    src="/images/welcome-hipo.png"
    alt="Imagen de chimuelo volando"
    class="absolute top-0 left-0 w-full h-full object-cover opacity-20"
  />

  <img
    src="/dragons/Desdentado.png"
    alt="Imagen de chimuelo volando"
    class="absolute top-[-8rem] left-[-5rem] w-[20rem] h-[20rem] object-cover z-50"
  />

  <img
    src="/dragons/Luciérnaga.png"
    alt="Imagen de chimuelo volando"
    class="absolute bottom-0 left-[-6rem] w-[20rem] h-[20rem] object-cover z-50"
  />

  <img
    src="/dragons/Light_Fury.png"
    alt="Imagen de chimuelo volando"
    class="absolute top-[-4rem] right-[-10rem] w-[20rem] h-[20rem] object-cover z-50"
  />
  <img
    src="/images/vikingos/viking-Hipo.png"
    data-aos="fade-up"
    alt="Imagen de chimuelo volando"
    class="absolute bottom-[-4rem] right-[-5rem] w-[17rem] h-[17rem] object-cover z-50"
  />

  <!-- Nubes -->
  <div class="welcome__cloud welcome__cloud--one"></div>
  <div class="welcome__cloud welcome__cloud--two"></div>
  <div class="welcome__cloud welcome__cloud--three"></div>

  <!-- Contenido -->
  <div class="welcome__content">
    <img
      src="/images/dreamworks-animation.svg"
      alt="Imagen de chimuelo volando"
      class="h-[5rem] object-cover z-50 opacity-50"
    />

    <p class="" data-aos="fade-in">UNA NUEVA AVENTURA COMIENZA...</p>

    <h1 class="welcome__name m-0" data-aos="fade-up">JESÚS ALEXANDER</h1>

    <div class="welcome__age">
      <span class="">MIS</span>
      <strong class="welcome__age-number">4</strong>
      <span class="text-8xl">AÑOS</span>
    </div>
    <div class="welcome__divider">
      <span></span>
      <span class="welcome__dragon-symbol">✦</span>
      <span></span>
    </div>

    <a href="#invitation" class="welcome__button z-50" data-aos="fade-up">
      <span>Descubrir</span>
      <span class="welcome__arrow">↓</span>
    </a>
  </div>

  <!-- Arbusto verde oscuro animado -->
  <div class="welcome__bush">
    <svg
      viewBox="0 0 1200 180"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Capa trasera (más oscura) -->
      <path
        class="bush-layer bush-layer--back"
        d="M0,180 L0,130 C 30,110 50,80 90,95 C 130,70 170,70 210,95 C 260,65 320,65 370,100 C 420,50 510,40 570,85 C 630,55 710,55 770,95 C 830,45 920,45 980,85 C 1030,60 1090,75 1130,95 C 1160,85 1180,105 1200,125 L1200,180 Z"
        fill="#2d5c31"
        stroke="#1b381e"
        stroke-width="3"></path>

      <!-- Capa delantera (verde principal intenso) -->
      <path
        class="bush-layer bush-layer--front"
        d="M0,180 L0,150 C 20,135 40,105 70,120 C 110,95 150,95 190,120 C 240,90 300,90 350,125 C 410,75 490,65 550,110 C 610,80 690,80 750,120 C 810,70 900,70 960,110 C 1010,85 1070,100 1110,120 C 1140,110 1170,130 1200,150 L1200,180 Z"
        fill="#366b3b"
        stroke="#224525"
        stroke-width="4"></path>
    </svg>
  </div>

  <!-- Niebla inferior -->
  <div class="welcome__fog"></div>
</section>
