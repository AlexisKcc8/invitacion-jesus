<!-- Cuenta Regresiva (Countdown Grid) -->
<section class="mt-6">
  <span class="apple-card__label apple-card__label--gold">SOLAMENTE FALTAN</span
  >

  <div class="apple-timer" aria-label="Cuenta regresiva">
    <div class="apple-timer__unit">
      <span id="invite-days" class="apple-timer__num">00</span>
      <span class="apple-timer__label">días</span>
    </div>
    <span class="apple-timer__colon">:</span>
    <div class="apple-timer__unit">
      <span id="invite-hours" class="apple-timer__num">00</span>
      <span class="apple-timer__label">hrs</span>
    </div>
    <span class="apple-timer__colon">:</span>
    <div class="apple-timer__unit">
      <span id="invite-minutes" class="apple-timer__num">00</span>
      <span class="apple-timer__label">min</span>
    </div>
    <span class="apple-timer__colon">:</span>
    <div class="apple-timer__unit">
      <span id="invite-seconds" class="apple-timer__num">00</span>
      <span class="apple-timer__label">seg</span>
    </div>
  </div>
</section>
<!-- SCRIPT DE CUENTA REGRESIVA -->
<script>
  const targetDate = new Date("2026-10-24T18:30:00-06:00").getTime();

  const daysEl = document.querySelector("#invite-days");
  const hoursEl = document.querySelector("#invite-hours");
  const minutesEl = document.querySelector("#invite-minutes");
  const secondsEl = document.querySelector("#invite-seconds");
  const messageEl = document.querySelector("#invite-countdown-message");

  function updateInvitationCountdown() {
    const remaining = targetDate - Date.now();

    if (remaining <= 0) {
      daysEl.textContent = "00";
      hoursEl.textContent = "00";
      minutesEl.textContent = "00";
      secondsEl.textContent = "00";
      messageEl.textContent = "¡Hoy comienza la aventura!";

      window.clearInterval(countdownInterval);
      return;
    }

    const days = Math.floor(remaining / 86400000);
    const hours = Math.floor((remaining / 3600000) % 24);
    const minutes = Math.floor((remaining / 60000) % 60);
    const seconds = Math.floor((remaining / 1000) % 60);

    daysEl.textContent = String(days).padStart(2, "0");
    hoursEl.textContent = String(hours).padStart(2, "0");
    minutesEl.textContent = String(minutes).padStart(2, "0");
    secondsEl.textContent = String(seconds).padStart(2, "0");
  }

  updateInvitationCountdown();
  const countdownInterval = window.setInterval(updateInvitationCountdown, 1000);
</script>
