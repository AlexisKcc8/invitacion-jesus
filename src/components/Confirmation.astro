<section
  class="px-6 py-8 max-w-5xl mx-auto bg-[#fdfbf7] text-[#292524] font-sans tracking-tight relative overflow-hidden"
>
  <!-- Estilos CSS para la animación realista de la lluvia -->
  <style>
    @keyframes rain-drop {
      0% {
        transform: translateY(-100%) scaleY(1);
        opacity: 0;
      }
      20% {
        opacity: 0.6;
      }
      100% {
        transform: translateY(180px) scaleY(1.3);
        opacity: 0;
      }
    }
    .rain-line {
      animation: rain-drop 2.2s linear infinite;
    }
  </style>

  <!-- Gotas de lluvia animadas y realistas -->
  <div
    class="absolute top-0 left-0 right-0 h-44 pointer-events-none overflow-hidden z-0 opacity-40"
  >
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <!-- Líneas delgadas que caen simulando lluvia suave -->
      <line
        x1="5%"
        y1="0"
        x2="4%"
        y2="30"
        stroke="#b45309"
        stroke-width="1.2"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0s; animation-duration: 1.8s;"></line>
      <line
        x1="15%"
        y1="0"
        x2="14%"
        y2="25"
        stroke="#d97706"
        stroke-width="1"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.5s; animation-duration: 2.1s;"></line>
      <line
        x1="28%"
        y1="0"
        x2="27%"
        y2="35"
        stroke="#b45309"
        stroke-width="1.5"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.2s; animation-duration: 1.9s;"></line>
      <line
        x1="42%"
        y1="0"
        x2="41%"
        y2="28"
        stroke="#d97706"
        stroke-width="1.1"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.8s; animation-duration: 2.3s;"></line>
      <line
        x1="55%"
        y1="0"
        x2="54%"
        y2="32"
        stroke="#b45309"
        stroke-width="1.3"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.1s; animation-duration: 2s;"></line>
      <line
        x1="68%"
        y1="0"
        x2="67%"
        y2="26"
        stroke="#d97706"
        stroke-width="1"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.6s; animation-duration: 2.2s;"></line>
      <line
        x1="82%"
        y1="0"
        x2="81%"
        y2="34"
        stroke="#b45309"
        stroke-width="1.4"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.3s; animation-duration: 1.85s;"></line>
      <line
        x1="93%"
        y1="0"
        x2="92%"
        y2="27"
        stroke="#d97706"
        stroke-width="1.1"
        stroke-linecap="round"
        class="rain-line"
        style="animation-delay: 0.9s; animation-duration: 2.15s;"></line>
    </svg>
  </div>

  <!-- Decoración Superior: Follaje y Enredaderas Colgantes Silvestres (SVG realista) -->
  <div
    class="absolute top-0 left-0 right-0 h-24 pointer-events-none z-10 overflow-hidden opacity-30"
  >
    <svg
      class="w-full h-full text-[#78350f]"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      fill="currentColor"
    >
      <!-- Malla de hojas, enredaderas y ramas cayendo con siluetas orgánicas estilo Berk -->
      <path
        d="M0,0 L1200,0 L1200,10 
        C1170,35 1150,65 1130,20 C1110,75 1090,15 1070,45 C1050,5 1030,85 1000,30 
        C980,60 960,15 940,55 C920,25 900,90 870,20 C850,65 830,10 800,50 
        C780,20 760,80 730,15 C710,60 690,30 660,75 C640,10 620,50 590,20 
        C570,85 550,15 520,60 C500,25 480,95 450,30 C430,70 410,10 380,55 
        C360,20 340,80 310,15 C290,65 270,25 240,70 C220,10 200,85 170,20 
        C150,60 130,15 100,50 C80,20 60,75 30,10 C15,40 5,20 0,10 Z"
      ></path>
      <!-- Detalles adicionales de hojas flotantes caídas -->
      <circle cx="150" cy="85" r="3"></circle>
      <circle cx="320" cy="95" r="2.5"></circle>
      <circle cx="610" cy="88" r="3.5"></circle>
      <circle cx="880" cy="102" r="2"></circle>
      <circle cx="1040" cy="90" r="3"></circle>
    </svg>
  </div>

  <!-- Encabezado -->
  <div class="text-center mb-10 relative z-20 pt-6">
    <img
      src="/dragons/Gruñón.png"
      alt="Imagen de chimuelo volando"
      class="absolute top-0 -right-22 w-3/5 h-3/5 object-cover"
    />
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f4] border border-[#e7e5e4] text-xs font-medium text-[#78716c] mb-4 shadow-sm"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
      Registro de Tripulación
    </div>

    <h2
      class="text-3xl phone-lg:text-4xl laptop:text-5xl font-semibold text-[#1c1917] tracking-tight mb-3"
      data-aos="fade-in"
    >
      Confirma tu Vuelo
    </h2>

    <p
      class="text-base laptop:text-lg text-[#78716c] font-normal max-w-xl mx-auto leading-relaxed"
      data-aos="fade-in"
    >
      Asegura tu lugar en la aldea antes del despegue. Queremos saber si
      contaremos con tu presencia en esta gran aventura.
    </p>
  </div>

  <!-- Formulario -->
  <form
    id="rsvp-form"
    class="max-w-xl mx-auto bg-[#f5f5f4]/80 p-8 rounded-2xl border border-[#e7e5e4] shadow-sm space-y-6 relative z-20 backdrop-blur-sm"
  >
    <!-- Nombre Completo -->
    <div class="space-y-2" data-aos="fade-up">
      <label
        for="nombre"
        class="block text-xs font-semibold tracking-wide text-[#57534e] uppercase"
      >
        Nombre del Jinete / Invitado
      </label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        placeholder="Ej. Astrid Hofferson"
        required
        class="w-full px-4 py-3 rounded-xl bg-[#ffffff] border border-[#d6d3d1] text-[#1c1917] placeholder-[#a8a29e] text-sm focus:outline-none focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309] transition-all duration-200"
      />
    </div>

    <!-- Confirmación de Asistencia -->
    <div class="space-y-2" data-aos="fade-up">
      <label
        class="block text-xs font-semibold tracking-wide text-[#57534e] uppercase"
      >
        ¿Asistirás a la celebración?
      </label>
      <div class="grid grid-cols-2 gap-4">
        <label
          class="flex items-center justify-center gap-2 p-3.5 rounded-xl bg-[#ffffff] border border-[#d6d3d1] cursor-pointer hover:border-[#a8a29e] transition-all duration-200 has-[:checked]:border-[#b45309] has-[:checked]:bg-[#fef3c7]/40"
        >
          <input
            type="radio"
            name="asistencia"
            value="si"
            class="sr-only"
            checked
            onchange="actualizarEstadoAsistencia()"
          />
          <span class="text-sm font-medium text-[#1c1917]"
            >¡Listo para volar! (Sí)</span
          >
        </label>
        <label
          class="flex items-center justify-center gap-2 p-3.5 rounded-xl bg-[#ffffff] border border-[#d6d3d1] cursor-pointer hover:border-[#a8a29e] transition-all duration-200 has-[:checked]:border-[#b45309] has-[:checked]:bg-[#fef3c7]/40"
        >
          <input
            type="radio"
            name="asistencia"
            value="no"
            class="sr-only"
            onchange="actualizarEstadoAsistencia()"
          />
          <span class="text-sm font-medium text-[#78716c]"
            >No podré asistir</span
          >
        </label>
      </div>
    </div>

    <!-- Número de Acompañantes / Pases -->
    <div class="space-y-2" data-aos="fade-up">
      <label
        for="pases"
        class="block text-xs font-semibold tracking-wide text-[#57534e] uppercase"
      >
        Pases / Acompañantes
      </label>
      <select
        id="pases"
        name="pases"
        class="w-full px-4 py-3 rounded-xl bg-[#ffffff] border border-[#d6d3d1] text-[#1c1917] text-sm focus:outline-none focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309] transition-all duration-200 disabled:bg-[#e7e5e4] disabled:text-[#a8a29e] disabled:cursor-not-allowed"
      >
        <option value="1 Pase (Solo yo)">1 Pase (Solo yo)</option>
        <option value="2 Pases">2 Pases</option>
        <option value="3 Pases">3 Pases</option>
        <option value="4 Pases">4 Pases</option>
        <option value="5 Pases">5 Pases</option>
        <option value="6 Pases">6 Pases</option>
        <option value="7 Pases">7 Pases</option>
        <option value="8 Pases">8 Pases</option>
        <option value="0 Pases" id="option-0-pases" class="hidden"
          >0 Pases</option
        >
      </select>
    </div>

    <!-- Mensaje Especial / Nota -->
    <div class="space-y-2" data-aos="fade-up">
      <label
        for="mensaje"
        class="block text-xs font-semibold tracking-wide text-[#57534e] uppercase"
      >
        Mensaje para la aldea <span class="text-[#a8a29e] font-normal lowercase"
          >(opcional)</span
        >
      </label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="3"
        placeholder="Escribe alguna restricción alimentaria o unas palabras especiales..."
        class="w-full px-4 py-3 rounded-xl bg-[#ffffff] border border-[#d6d3d1] text-[#1c1917] placeholder-[#a8a29e] text-sm focus:outline-none focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309] transition-all duration-200 resize-none"
      ></textarea>
    </div>

    <!-- Botón de Envío -->
    <div class="pt-2" data-aos="fade-up">
      <button
        type="submit"
        class="flex items-center justify-center gap-2.5 w-full py-3.5 px-6 rounded-full bg-[#1c1917] hover:bg-[#292524] text-[#f5f5f4] font-medium text-sm transition-all duration-300 shadow-md active:scale-[0.98]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
          ></path>
        </svg>
        <span>Enviar Confirmación vía WhatsApp</span>
      </button>
    </div>
  </form>
</section>

<!-- Script de lógica dinámicas -->
<script>
  function actualizarEstadoAsistencia() {
    const asistencia = document.querySelector(
      'input[name="asistencia"]:checked',
    ).value;
    const pasesSelect = document.getElementById("pases");
    const option0 = document.getElementById("option-0-pases");

    if (asistencia === "no") {
      option0.classList.remove("hidden");
      pasesSelect.value = "0 Pases";
      pasesSelect.disabled = true;
    } else {
      pasesSelect.disabled = false;
      option0.classList.add("hidden");
      if (pasesSelect.value === "0 Pases") {
        pasesSelect.value = "1 Pase (Solo yo)";
      }
    }
  }

  document
    .getElementById("rsvp-form")
    .addEventListener("submit", function (event) {
      event.preventDefault();

      const telefono = "529841055093";

      // Obtención de valores
      const nombre = document.getElementById("nombre").value.trim();
      const asistenciaRadio = document.querySelector(
        'input[name="asistencia"]:checked',
      ).value;
      const mensajeInput = document.getElementById("mensaje").value.trim();
      const mensaje = mensajeInput !== "" ? mensajeInput : "Ninguno";

      let estadoAsistencia = "";
      let pasesText = "";
      let encabezado = "";
      let despedida = "";

      if (asistenciaRadio === "si") {
        encabezado = "🐉 *CONFIRMACIÓN DE ASISTENCIA AL CUMPLE DE JESUS* 🐉";
        estadoAsistencia = "¡Listo para volar! (Sí asistiré)";
        pasesText = document.getElementById("pases").value;
        despedida = "_¡Nos vemos pronto en la aventura!_";
      } else {
        encabezado = "🐉 *RESPUESTA DE AUSENCIA AL CUMPLE DE JESUS* 🐉";
        estadoAsistencia = "Lamento no poder asistir 😔";
        pasesText = "0 Pases";
        despedida = "_¡Siento mucho no poder acompañarlos en esta aventura!_";
      }

      // Construcción del mensaje
      const texto =
        `${encabezado}\n\n` +
        `👤 *Jinete/Invitado:* ${nombre}\n` +
        `📌 *Estado:* ${estadoAsistencia}\n` +
        `🎟️ *Pases:* ${pasesText}\n` +
        `✍️ *Nota/Mensaje:* ${mensaje}\n\n` +
        `${despedida}`;

      // Enlace a WhatsApp
      const whatsappUrl = `https://api.whatsapp.com/send?phone=${telefono}&text=${encodeURIComponent(texto)}`;

      // Redirección
      window.open(whatsappUrl, "_blank");

      // Limpia todo el formulario
      event.target.reset();
      actualizarEstadoAsistencia();
    });
</script>
