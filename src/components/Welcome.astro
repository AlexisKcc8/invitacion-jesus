---
import Countdown from "./Countdown.astro";
---

<!-- Cargar fuente San Francisco / Inter para emular el estilo de Apple -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<div class="apple-wrapper">
  <main class="apple-main">
    <!-- Hero Section (Estilo Apple Launch con Acento en la Edad) -->

    <section class="apple-hero overflow-hidden">
      <div class="welcome__sky"></div>

      <img
        src="/images/welcome-hipo.png"
        alt="Imagen de chimuelo volando"
        class="absolute top-0 left-0 w-full h-full object-cover opacity-10"
      />

      <img
        src="/dragons/Luciérnaga.png"
        alt="Imagen de chimuelo volando"
        class="absolute top-14 -left-26 w-88 h-88 object-cover"
      />

      <img
        src="/dragons/Light_Fury.png"
        alt="Imagen de Light_Fury volando"
        class="absolute top-24 -right-36 w-88 h-88 object-cover"
      />

      <!-- Nubes -->
      <div class="welcome__cloud welcome__cloud--one"></div>
      <div class="welcome__cloud welcome__cloud--two"></div>
      <div class="welcome__cloud welcome__cloud--three"></div>

      <div
        class="flex flex-col items-center justify-center text-center relative z-10"
      >
        <p class="apple-hero__eyebrow">UNA AVENTURA COMIENZA...</p>
        <h1 class="apple-hero__title" data-aos="fade-in">Jesús Alexander</h1>
        <div class="apple-hero__age">
          <span>MIS</span>
          <strong class="apple-hero__age-number">4</strong>
          <span>AÑOS</span>
        </div>

        <img
          src="/images/vikingos/dragon-team.png"
          alt="Imagen de hipo y chimuelo"
          class="w-3/5 h-3/5 object-cover"
        />
      </div>

      <!-- Fecha y Hora Estilo Imagen Compartida -->
      <section>
        <span class="apple-card__label" data-aos="fade-up"
          >Un día especial, un recuerdo para toda la vida.</span
        >

        <div class="date-stamp">
          <div class="date-stamp__top">
            <!-- Bloque Izquierdo: Día de la semana -->
            <div class="date-stamp__side">
              <span class="date-stamp__line"></span>
              <span class="date-stamp__weekday">SÁBADO</span>
              <span class="date-stamp__line"></span>
            </div>

            <!-- Centro: Número del día -->
            <div class="date-stamp__day">24</div>

            <!-- Bloque Derecho: Mes -->
            <div class="date-stamp__side">
              <span class="date-stamp__line"></span>
              <span class="date-stamp__month">Octubre</span>
              <span class="date-stamp__line"></span>
            </div>
          </div>

          <!-- Hora centrada abajo -->
          <div class="date-stamp__time">6:30 P. M.</div>
        </div>
      </section>

      <Countdown />

      <!-- Arbusto verde oscuro animado -->
      <div class="welcome__bush">
        <svg
          viewBox="0 0 1200 180"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Capa trasera (más oscura) -->
          <path
            class="bush-layer bush-layer--back"
            d="M0,180 L0,130 C 30,110 50,80 90,95 C 130,70 170,70 210,95 C 260,65 320,65 370,100 C 420,50 510,40 570,85 C 630,55 710,55 770,95 C 830,45 920,45 980,85 C 1030,60 1090,75 1130,95 C 1160,85 1180,105 1200,125 L1200,180 Z"
            fill="#2d5c31"
            stroke="#1b381e"
            stroke-width="3"></path>

          <!-- Capa delantera (verde principal intenso) -->
          <path
            class="bush-layer bush-layer--front"
            d="M0,180 L0,150 C 20,135 40,105 70,120 C 110,95 150,95 190,120 C 240,90 300,90 350,125 C 410,75 490,65 550,110 C 610,80 690,80 750,120 C 810,70 900,70 960,110 C 1010,85 1070,100 1110,120 C 1140,110 1170,130 1200,150 L1200,180 Z"
            fill="#366b3b"
            stroke="#224525"
            stroke-width="4"></path>
        </svg>
      </div>
    </section>
  </main>
</div>
