---
import "../styles/global.css";

import Welcome from "../components/Welcome.astro";
import Confirmation from "../components/Confirmation.astro";
import MusicToggle from "../components/MusicToggle.astro";
import OurLocation from "../components/OurLocation.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Invitación al cumpleaños de Jesús Alexander."
    />

    <title>Jesús Alexander | 4 años</title>
  </head>

  <body>
    <main>
      <Welcome />
      <OurLocation />
      <Confirmation />
    </main>

    <MusicToggle />

    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";

      document.addEventListener("DOMContentLoaded", () => {
        AOS.init({
          duration: 800,
          once: true,
          startEvent: "DOMContentLoaded",
        });

        AOS.refreshHard();
      });
    </script>
  </body>
</html>
